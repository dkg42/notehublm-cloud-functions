{
  "name": "notehublm-cloud-functions",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dodopayments": "^2.29.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "firebase-tools": "^15.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.2"
  }
}
