{
  "name": "notehublm-cloud-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions backend for NoteHub LM: Dodo Payments webhooks, subscription claims, and Google OAuth token brokerage.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkg42/notehublm-cloud-functions.git"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dodopayments": "^2.29.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^10.6.2",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "firebase-tools": "^15.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.2"
  }
}
