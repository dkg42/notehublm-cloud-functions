# ─────────────────────────────────────────────────────────────────────────────
# Example environment file.
#
# Copy to `.env.local` for emulator work, or to `.env.<firebase-project-id>`
# for a deployed environment. Both are resolved by the Firebase CLI; `.env.local`
# is emulator-only and is never deployed.
#
# IMPORTANT: the three values marked SECRET below must NEVER be written to a
# `.env.<project-id>` file, because those files are committed. In deployed
# environments they come from Secret Manager:
#
#   firebase functions:secrets:set DODO_PAYMENTS_WEBHOOK_SECRET --project <id>
#
# `.env.local` is gitignored and is the only place a real secret may sit on disk.
# ─────────────────────────────────────────────────────────────────────────────

# ── Non-secret configuration (safe to commit per-project) ────────────────────

# Dodo Payments mode. Defaults to `test_mode` in src/config.ts so that a missing
# value can never accidentally transact against live payments.
DODO_ENV=test_mode

# Dodo product IDs, used to map an incoming product_id to a subscription plan.
DODO_PRODUCT_ID_PRO_MONTHLY=pdt_replace_me_monthly
DODO_PRODUCT_ID_PRO_YEARLY=pdt_replace_me_yearly

# Google OAuth 2.0 *client ID* (public by design — it ships in browser clients).
GOOGLE_CLIENT_ID=000000000000-replaceme.apps.googleusercontent.com

# Comma-separated CORS allowlist for the callable endpoints. Required.
# This fails closed: if it is empty, every cross-origin call is rejected.
ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000,chrome-extension://replacemeextensionid

# ── SECRET values — Secret Manager in deployed envs, `.env.local` locally ────

# Dodo webhook signing secret, used to verify inbound webhook signatures.
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_replace_me

# Dodo REST API bearer token (adminReplayWebhook + customer portal sessions).
DODO_PAYMENTS_API_KEY=replace_me

# Google OAuth 2.0 client secret. Never leaves the Cloud Function.
GOOGLE_CLIENT_SECRET=replace_me

# Shared secret for the `x-admin-secret` header on the admin endpoints.
ADMIN_SECRET=replace_me
